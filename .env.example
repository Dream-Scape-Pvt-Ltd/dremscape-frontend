# Backend API root; server-only. Set the deployed HTTPS API address in hosting.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
FRONTEND_INTERNAL_KEY=
# Public API origin used by account services. Set before the frontend build.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_COMPANY_EMAIL=info@dreamscapetreks.com
# Optional direct film; latest channel video takes priority when configured.
NEXT_PUBLIC_TREK_FILM_URL=
YOUTUBE_CHANNEL_HANDLE=@Dreamscapetreks
# Server-only YouTube Data API v3 key. Never use NEXT_PUBLIC_ for secrets.
YOUTUBE_API_KEY=
# Optional GA4 measurement ID (G-...). Analytics loads only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Maps JavaScript API key for trek route maps. Browser-visible: restrict it by HTTP referrer
# and to the Maps JavaScript API in Google Cloud. The route map is hidden when blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Map Management) for Advanced Markers; DEMO_MAP_ID is used when blank.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Backend API root; server-only. Set the deployed HTTPS API address in hosting.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
# Public API origin used by account services. Set before the frontend build.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_COMPANY_EMAIL=dreamscapetrek@gmail.com
NEXT_PUBLIC_COMPANY_WHATSAPP=9779761424745
# Optional direct film; latest channel video takes priority when configured.
NEXT_PUBLIC_TREK_FILM_URL=
YOUTUBE_CHANNEL_HANDLE=@Dreamscapetreks
# Server-only YouTube Data API v3 key. Never use NEXT_PUBLIC_ for secrets.
YOUTUBE_API_KEY=
